<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    <!-- TLHSymbolReferenceTemplate — Phase 6 / CFG-12 cheat-sheet image at the
         top of the config panel.

         Texture path is inlined directly on the <Texture> file= attribute
         (see Phase 6 fix d76ee9a — Settings.CreateElementInitializer's data
         table is held by the initializer, NOT the rendered frame, so OnLoad's
         self.data was always nil; inline file= bypasses that data flow).

         Texture has explicit Size + CENTER anchor (no setAllPoints) because
         the Settings vertical-layout overrides the parent Frame's WIDTH to
         match the panel content area (~640px) — setAllPoints would stretch
         the 319x143 image horizontally to fill the wider frame. With
         explicit Size, the texture stays at native 319x143 dimensions
         centered in whatever frame width the layout assigns. -->
    <Frame name="TLHSymbolReferenceTemplate" virtual="true">
        <Size x="319" y="143"/>
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="Image" file="Interface\AddOns\TerribleLuraHelper\reference.tga">
                    <Size x="319" y="143"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
    </Frame>
</Ui>
